# ──────────────────────────────────────────────────────────────────────────────
# NexusAgent Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control!
# ──────────────────────────────────────────────────────────────────────────────

# ── Circle Developer-Controlled Wallets ───────────────────────────────────────
# Obtain from: https://console.circle.com → Developers → API Keys
CIRCLE_API_KEY=

# Your generated entity secret (32-byte hex, kept ONLY on your server)
# Steps to generate:
#   1. openssl rand -hex 32   (or use Node: crypto.randomBytes(32).toString('hex'))
#   2. Paste the raw hex below AND register the hashed version on Circle Console
#      (Settings → Entity Secret Ciphertext)
CIRCLE_ENTITY_SECRET=

# USDC Token ID on ARC-TESTNET (needed for Phase 2 nanopayments)
# Find this in Circle Console → Tokens, or query the Circle API:
#   GET https://api.circle.com/v1/w3s/tokens?blockchain=ARC-TESTNET
# Leave blank to use mock payments for demo (safe for Phase 2 testing)
CIRCLE_USDC_TOKEN_ID=

# ── Groq LLM (for AI agents in later phases) ──────────────────────────────────
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
