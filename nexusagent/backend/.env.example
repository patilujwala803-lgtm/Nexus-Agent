# ──────────────────────────────────────────────────────────────────────────────
# NexusAgent Environment Variables — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ── Circle Developer-Controlled Wallets ───────────────────────────────────────
# Get from: https://console.circle.com — Developer credentials
CIRCLE_API_KEY=your_circle_api_key_here

# Generated by setup-entity-secret.ts
CIRCLE_ENTITY_SECRET=your_entity_secret_here

# USDC Token ID on ARC-TESTNET (fill after wallet creation)
CIRCLE_USDC_TOKEN_ID=your_usdc_token_id_here

# ── Bynara API (Claude Sonnet 4.5) ────────────────────────────────────────────
# Get from: https://bynara.id — create account and generate key
BYNARA_API_KEY=your_bynara_api_key_here

# ── Firebase Admin SDK (Backend) ──────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download JSON → copy values here
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="your_private_key_with_quotes_preserved"

# ── Firebase Client SDK (Frontend) ────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → General
# → Your apps → Add app → Web → copy config values
# (Set these in frontend/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
