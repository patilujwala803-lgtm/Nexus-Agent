# Environment variables - NEVER commit these
.env
.env.local
.env.*.local

# Wallet files - contain sensitive wallet info
wallets.json
*wallets*.json

# Circle recovery files - highly sensitive
*recovery-file*
*recovery*.dat

# Node modules
node_modules/
**/node_modules/

# TypeScript build output
dist/
build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/

# Package lock files (optional - remove if you want to commit them)
# package-lock.json
# yarn.lock
